# Copy to .env and fill in. Never commit .env.

# ── BACKEND (owner: Jayden) ────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ghostwatch:ghostwatch@localhost:5432/ghostwatch
TEST_DATABASE_URL=postgresql+psycopg://ghostwatch:ghostwatch@localhost:5432/ghostwatch_test
GHOSTWATCH_API_KEY=change-me-local-ingest-key
CORS_ORIGINS=http://localhost:3000

# Investigation provider: "fable" or "rule_based" (rule_based needs no key and no network)
LLM_PROVIDER=rule_based
ANTHROPIC_API_KEY=
LLM_MODEL=claude-fable-5-2
LLM_TIMEOUT_SECONDS=60

# Anomaly sweeper interval
SWEEPER_INTERVAL_SECONDS=30

# SDK / demo
GHOSTWATCH_API_URL=http://localhost:8000/api/v1

# ── FRONTEND (owner: Adit) ─────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# "mock" serves contract fixtures; "live" calls the backend
NEXT_PUBLIC_API_MODE=mock
