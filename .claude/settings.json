{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/save-state.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact|startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rehydrate.sh"
          }
        ]
      }
    ]
  }
}
